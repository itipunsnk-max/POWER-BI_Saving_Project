//     COUNTROWS (
//         FILTER (
//             SecurityUserSite,
//             LOWER ( SecurityUserSite[UserUPN] ) = _UPN
//                 && SecurityUserSite[SiteKey] = _SiteKey
//                 && SecurityUserSite[IsActive] = TRUE ()
//                 && SecurityUserSite[ValidFrom] <= TODAY ()
//                 && (
//                     ISBLANK ( SecurityUserSite[ValidTo] )
//                         || SecurityUserSite[ValidTo] >= TODAY ()
//                 )
//         )
